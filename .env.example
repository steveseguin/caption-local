CAPTION_MODEL=small
CAPTION_THREADS=4
CAPTION_PORT=8765
# Set to 1 only after this model has downloaded successfully into the volume.
CAPTION_OFFLINE=0

# Concurrent model workers; threads above are per worker.
CAPTION_WORKERS=1
CAPTION_MAX_STREAMS=12

# Decoder search width (1–5); smaller is faster, accuracy can change.
CAPTION_BEAM_SIZE=5
